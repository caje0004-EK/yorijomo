---
// MobileMenu.astro
---

<div class="mobile-menu" id="mobile-overlay" aria-hidden="true">
  <nav class="mobile-menu-content">
    
    <!-- SHOP -->
    <div class="menu-group">
      <h2 class="menu-title">SHOP</h2>
      
      <!-- SKO -->
      <div class="menu-subgroup">
        <h3 class="menu-subtitle">SKO</h3>
        <ul class="menu-links">
          <li><a href="/shop/sko">Se alle</a></li>
          <li><a href="/shop/sko/nyheder">Nyheder</a></li>
          <li><a href="/shop/sko/loafers">Loafers</a></li>
          <li><a href="/shop/sko/ballerinaer">Ballerinaer</a></li>
          <li><a href="/shop/sko/flats">Flats</a></li>
        </ul>
      </div>

      <!-- ACCESSORIES -->
      <div class="menu-subgroup">
        <h3 class="menu-subtitle">ACCESSORIES</h3>
        <ul class="menu-links">
          <li><a href="/shop/accessories">Se alle</a></li>
          <li><a href="/shop/accessories/nyheder">Nyheder</a></li>
          <li><a href="/shop/accessories/baelter">Bælter</a></li>
        </ul>
      </div>
    </div>

    <!-- FORHANDLERE & OM OS -->
    <div class="menu-group main-links">
      <a href="/forhandlere" class="menu-title-link">FORHANDLERE</a>
      <a href="/om-os" class="menu-title-link">OM OS</a>
    </div>

    <!-- Sprog & Valuta -->
    <div class="mobile-selectors">
      <button type="button" class="selector-btn">
        <span>DK</span>
        <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.2"/></svg>
      </button>
      <button type="button" class="selector-btn">
        <span>DKK</span>
        <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.2"/></svg>
      </button>
    </div>

  </nav>
</div>

<style>
.mobile-menu {
  font-family: var(--font-family-regular);
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  background-color: #fff;
  display: none;
  overflow-y: auto;
  z-index: 999;
  padding: 100px var(--space-md, 16px) 40px;
}

.mobile-menu.is-active {
  display: block;
}

.mobile-menu-content {
  display: flex;
  flex-direction: column;
  gap: var(--space-xl, 24px);
}

.menu-group {
  display: flex;
  flex-direction: column;
  gap: var(--space-md, 12px);
}

.menu-title,
.menu-title-link {
  font-family: var(--font-family-headline);
  font-size: 1.25rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: #000;
  text-decoration: none;
  margin: 0;
}

.menu-subgroup {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm, 8px);
}

.menu-subtitle {
  font-family: var(--font-family-headline);
  font-size: 1.1rem;
  font-weight: 500;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  margin: 0;
}

.menu-links {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.menu-links a {
  color: #666;
  text-decoration: none;
  font-size: 1rem;
}

.mobile-selectors {
  display: flex;
  gap: 20px;
  margin-top: 16px;
}

.selector-btn {
  display: flex;
  align-items: center;
  gap: 4px;
  background: none;
  border: none;
  padding: 0;
  font-size: 0.9rem;
  cursor: pointer;
}

@media (min-width: 960px) {
  .mobile-menu {
    display: none !important;
  }
}
</style>