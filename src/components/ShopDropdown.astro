---
// ShopDropdown.astro
---

<div class="mega-dropdown tablet-hide">
  <div class="dropdown-content container-full flex justify-between">
    
    <!-- Venstre side: Kategori-kolonner -->
    <div class="flex gap-xxl">
      <!-- SKO -->
      <div class="dropdown-col">
        <h3 class="dropdown-title">SKO</h3>
        <ul class="dropdown-links">
          <li><a href="/shop/sko">Se alle</a></li>
          <li><a href="/shop/sko/nyheder">Nyheder</a></li>
          <li><a href="/shop/sko/loafers">Loafers</a></li>
          <li><a href="/shop/sko/ballerinaer">Ballerianer</a></li>
          <li><a href="/shop/sko/flats">Flats</a></li>
        </ul>
      </div>

      <!-- ACCESSORIES -->
      <div class="dropdown-col">
        <h3 class="dropdown-title">ACCESSORIES</h3>
        <ul class="dropdown-links">
          <li><a href="/shop/accessories">Se alle</a></li>
          <li><a href="/shop/accessories/nyheder">Nyheder</a></li>
          <li><a href="/shop/accessories/baelter">Bælter</a></li>
        </ul>
      </div>
    </div>

    <!-- Højre side: Billeder med links -->
    <div class="flex gap-md">
      <a href="/shop/sko" class="dropdown-card">
        <img src="/yori-jomo-bench.jpg" alt="Sko">
        <span>SKO</span>
      </a>
      <a href="/shop/accessories/baelter" class="dropdown-card">
        <img src="/yori-jomo-belt.png" alt="Bælter">
        <span>BÆLTER</span>
      </a>
    </div>

  </div>
</div>

<style>
/* Mega Dropdown Panel Styling */
.mega-dropdown {
  font-family: var(--font-family-regular);
  position: fixed; /* Låser panelet til skærmens fulde bredde i stedet for Shop-linket */
  top: 60px; /* Tilpas denne højde så den passer med bunden af din header */
  left: 0;
  width: 100vw;
  background-color: var(--color-bright, #fff);
  padding: 40px 0;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
  
  /* Hover/visnings-logik */
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity 0.25s ease, visibility 0.25s ease;
  z-index: 1000;
}

/* Typografi & Link Styling */
.dropdown-title {
  font-family: var(--font-family-headline);
  font-size: 0.9rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 16px;
}

.dropdown-links {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.dropdown-links a {
  color: #555;
  text-decoration: none;
  font-size: 0.95rem;
  font-weight: 300;
  transition: color 0.2s ease;
}

.dropdown-links a:hover {
  color: #000;
}

/* Billedkort i højre side */
.dropdown-card {
  display: flex;
  flex-direction: column;
  gap: 12px;
  text-decoration: none;
  color: inherit;
  width: 200px;
}

.dropdown-card img {
  width: 100%;
  height: 240px;
  object-fit: cover;
}

.dropdown-card span {
  font-family: var(--font-family-headline);
  font-size: 0.85rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.dropdown-content {
  padding-left: var(--space-xl, 32px); 
  padding-right: var(--space-xl, 32px);
}

.site-header {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 1000;
  background-color: transparent; /* Gennemsigtig som standard */
  transition: background-color 0.25s ease;
}

/* Gør hele headeren hvid, når man hoover på Shop / dropdown-parent */
.site-header:has(.dropdown-parent:hover) {
  background-color: #ffffff;
}
</style>