---
import ButtonPrimary from "./ButtonPrimary.astro";
---

<section class="Historie-section slide-top">
  <div class="Historie-content">
    <h1>HÅNDLAVET I <span>ITALIEN</span></h1>
    <p>Fra vores studie i København former vi sko med fokus på langtidsholdbart håndværk og ærlige materialer. Alle vores sko bliver håndlavet i Toscana, Italien, i små, begrænsede produktioner.</p>
    <div class="Button">
      <ButtonPrimary text="LÆS OM VORES HISTORIE" />
    </div>
  </div>

  <div class="Historie-images">
    <img class="Image-left" src="/Images/Historie1.png" alt="Img1" />
    <img class="Image-right" src="/Images/Historie2.png" alt="Img2" />
  </div>
</section>

<style>
  /* MOBILE FIRST */
  .Historie-section {
    padding: var(--space-3);
  }

  .Historie-content {
    max-width: 480px;
    margin: 0 auto;
    text-align: center;
  }

  .Historie-content h1 {
    font-family: var(--font-family-headline);
    font-size: var(--headline-medium-size);
    font-weight: var(--font-weight-regular);
    margin: 20 0 16px;
    color: var(--grey-900);
  }

  .Historie-content h1 span {
    color: var(--oat-500);
    font-size: var(--headline-large-size);
  }

  .Historie-content p {
    font-size: var(--label-medium-size);
    font-family: var(--font-family-regular);
    line-height: 1.5;
    margin: 0 auto 16px;
    color: var(--grey-900);
    text-align: center;
    max-width: 350px;
  }

  .Historie-images {
    display: block;
    margin-top: 24px;
    padding: 20px;
  }

  .Historie-images img {
    display: block;
    width: 90%;
    height: auto;
    margin: 0 auto;
  }

  .Image-left {
    display: block;
  }

  .Image-right {
    display: none;
    position: relative;
    top: 60px;
  }

  .slide-top {
    opacity: 0;
    transform: translateY(100px);
  }

  .slide-top.is-visible {
    animation: slide-top 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
  }

  @keyframes slide-top {
    0% {
      opacity: 0;
      transform: translateY(100px);
    }

    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 601px) {
    .Historie-section {
      padding: 48px 6%;
    }

    .Historie-content p {
      font-size: var(--label-medium-size);
      font-family: var(--font-family-regular);
      line-height: 1.6;
      max-width: 400px;
    }

    .Historie-images {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
      align-items: start;
      margin-top: 40px;
    }

    .Image-right {
      display: block;
      margin-top: 30px;
    }
  }

  @media (min-width: 1024px) {
    .Historie-section {
      padding: 64px 6%;
    }

    .Historie-content p {
      max-width: 450px;
    }

    .Historie-images {
      gap: 5%;
      margin-top: 56px;
    }

    .Image-right {
      margin-top: 75px;
    }
  }

  @media (max-width: 600px) {
    .Historie-section .Historie-images .Image-right {
      display: none !important;
    }
  }
</style>

<script>
  const animatedElements = document.querySelectorAll(".Historie-section.slide-top");

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      });
    },
    {
      threshold: 0.15,
    },
  );

  animatedElements.forEach((element) => {
    observer.observe(element);
  });
</script>
